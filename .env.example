# Copia este archivo como .env y completa los valores.

NODE_ENV=development
PORT=3000

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/contrata

# Clave para firmar las sesiones. Mínimo 32 caracteres, distinta en cada entorno.
JWT_SECRET=
# Duración de la sesión en segundos (43200 = 12 horas).
JWT_EXPIRES_IN_SECONDS=43200

# Direcciones del frontend que pueden llamar a la API, separadas por coma.
CORS_ORIGIN=http://localhost:5173

# Primer administrador, lo crea `npm run seed`.
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=

# Fotos en Cloudflare R2. Opcional: sin estas cuatro variables la API arranca,
# pero no acepta fotos. Si defines una, define las cuatro.
# Cómo obtenerlas: README → «Fotos en Cloudflare R2».
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Alternativa a R2 para desarrollo: guardar las fotos en una carpeta del disco.
# Se ignora si R2 está configurado. La carpeta uploads/ ya está en .gitignore.
STORAGE_LOCAL_DIR=uploads
# Dirección pública de la API (para los enlaces de las fotos locales).
PUBLIC_API_URL=http://localhost:3000/api
